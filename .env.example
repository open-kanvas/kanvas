# Non-secret examples only. Node does not load this file automatically.
HOST=127.0.0.1
PORT=8787
KANVAS_PUBLIC_URL=http://127.0.0.1:8787
# KANVAS_DOCS_URL=https://docs.example.com
# Full-account browser sessions; paired/capture grants retain their short scopes.
KANVAS_BROWSER_IDLE_DAYS=90
KANVAS_BROWSER_ABSOLUTE_DAYS=365
KANVAS_BROWSER_RENEWAL_HOURS=24
KANVAS_BROWSER_FRESH_MINUTES=15
KANVAS_ALLOW_REGISTRATION=false
KANVAS_MCP_PROFILE=discovery
KANVAS_PUBLISH_SETUP=true
KANVAS_PAIRING_FAILED_LIMIT=50
KANVAS_SERVICE_ADMINS=
KANVAS_DEV_CLIENT=false
KANVAS_LOG_OAUTH_DIAGNOSTICS=false

# PostgreSQL is the only runtime store. Provision a dedicated role/database.
KANVAS_PG_HOST=/var/run/postgresql
KANVAS_PG_PORT=5432
KANVAS_PG_DATABASE=kanvas
KANVAS_PG_USER=kanvas
KANVAS_PG_SCHEMA=public
KANVAS_PG_POOL_SIZE=8
# Unix socket/local private network only; use verify-full for remote PostgreSQL.
KANVAS_PG_SSL=disable
# KANVAS_PG_CA_FILE=/path/to/ca-certificate.pem
# Password material must be in a private, service-readable regular file.
# KANVAS_PG_PASSWORD_FILE=/run/credentials/kanvas-database-password
# Service managers may supply CREDENTIALS_DIRECTORY (do not put its contents here).

# Email sign-in needs the host-owned kanvas-mailer service credential.
KANVAS_EMAIL_SIGNIN=false
KANVAS_MAIL_FROM=KANVAS <noreply@example.com>

# Public browser-visible map configuration; never include credentials.
KANVAS_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
KANVAS_MAP_ATTRIBUTION=OpenStreetMap contributors
KANVAS_MAP_ATTRIBUTION_URL=https://www.openstreetmap.org/copyright

# Tests must target an isolated database, never the application database.
# KANVAS_TEST_PG_HOST=/path/to/test-postgresql-socket
# KANVAS_TEST_PG_PORT=5432
# KANVAS_TEST_PG_DATABASE=kanvas_test
# KANVAS_TEST_PG_USER=test_runner

# Native MCP invitation sends are explicit and disabled by default.
# Reuses KANVAS_MAIL_FROM and the protected kanvas-mailer systemd credential.
KANVAS_INVITE_EMAIL=false

# Optional: external operator-updated MaxMind database; no key is needed by Kanvas.
# KANVAS_GEOLITE_CITY_PATH=/var/lib/GeoIP/GeoLite2-City.mmdb
