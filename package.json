{
  "name": "kanvas",
  "version": "0.33.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:client": "vite --host 127.0.0.1",
    "build": "tsc --noEmit -p tsconfig.build.json && vite build && tsup",
    "start": "node dist/server/index.js",
    "check": "tsc --noEmit -p tsconfig.build.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run build && npm run test:e2e",
    "backup": "node dist/server/backup-postgres.js",
    "create-user": "node dist/server/create-user.js",
    "check:all": "tsc --noEmit",
    "migrate:sqlite": "node dist/server/migrate-sqlite.js",
    "test:postgres": "vitest run tests/core/postgresql.test.ts tests/core/postgresql-app.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/express": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "geoip-lite": "^2.0.3",
    "highlight.js": "^11.11.1",
    "leaflet": "^1.9.4",
    "perfect-freehand": "^1.2.2",
    "pg": "8.16.3",
    "playwright": "1.63.0",
    "qrcode": "1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "saxes": "6.0.0",
    "web-push": "^3.6.7",
    "zod": "^4.1.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@playwright/test": "^1.63.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/geoip-lite": "^1.4.4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.0.0",
    "@types/pg": "8.15.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "ajv": "8.20.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.2.0",
    "vitest": "^3.2.0",
    "@types/web-push": "^3.6.4",
    "@types/three": "0.187.0"
  }
}
